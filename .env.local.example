# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se sube al repositorio (ver .gitignore).

# --- Sanity (CMS del blog y el catalogo) ---
# Se obtienen al crear el proyecto en https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Solo necesario para el script de importacion masiva (npm run import:sanity).
# Generalo en sanity.io/manage > tu proyecto > API > Tokens > Add API token,
# con permisos "Editor". No lo requiere el sitio publico.
SANITY_API_TOKEN=

# --- Google Analytics (GA4) ---
# ID de medicion del stream Web, se obtiene en analytics.google.com > Admin > Flujos de datos.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Tag Manager ---
# ID del contenedor (GTM-XXXXXXX), se obtiene en tagmanager.google.com.
NEXT_PUBLIC_GTM_ID=

# --- Envio de correo para "Solicitud de cotizacion" ---
# Datos SMTP de tu cuenta de correo de cPanel (o el proveedor que uses)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Recibe SIEMPRE todas las solicitudes de cotizacion (gerencia)
QUOTE_TO_EMAIL=gerencia@alquileresymas.net
# Ademas, cada solicitud va a UNO de estos correos de ventas, al que menos lleve
# (empate = al azar). Separados por coma. Vacio = ventas, ventas1, ventas2 y ventas3
# @alquileresymas.net. Ver los contadores con: npm run reparto
# Los contadores se guardan en Sanity y necesitan SANITY_WRITE_TOKEN (mas abajo);
# sin el, se reparte al azar sin contar.
VENTAS_EMAILS=

# --- Aviso por WhatsApp de cada solicitud (a quien se asigno) ---
# Usa CallMeBot (gratis). Para obtener la apikey, desde el WhatsApp que va a recibir
# los avisos: sigue los pasos de https://www.callmebot.com/blog/free-api-whatsapp-messages/
# (agregar el numero del bot y enviarle "I allow callmebot to send me messages").
# Te responde con tu apikey.
# Sin apikey no se envia aviso (todo lo demas funciona igual).
CALLMEBOT_APIKEY=
# Numero que recibe el aviso, con codigo de pais y sin signos. Vacio = 50766728087
WHATSAPP_AVISO_TELEFONO=

# --- Captcha Cloudflare Turnstile (formulario de cotizacion) ---
# Se obtienen gratis en dash.cloudflare.com > Turnstile > Add widget.
# Si se dejan vacias, el formulario funciona sin captcha (solo honeypot).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Contador de "Lo mas visto" en la portada ---
# Token de Sanity con permiso de escritura (Editor), solo para sumar visitas a
# los documentos "vistasSemana". Sin el, el sitio funciona igual pero no cuenta.
SANITY_WRITE_TOKEN=
